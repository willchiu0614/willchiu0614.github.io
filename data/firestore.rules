rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/refundRecords/{recordId} {
      function ownsRecord() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validRecord() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'schemaVersion', 'id', 'storeName', 'createdAt', 'updatedAt', 'calculationMode', 'items', 'purchaseTotalYen',
            'taxRate', 'exchangeRate', 'taxExclusivePurchaseYen', 'refundBeforeFeeYen',
            'serviceFeeYen', 'payoutYen', 'payoutTwd', 'roundingAdjustmentYen'
          ])
          && data.keys().hasOnly([
            'schemaVersion', 'id', 'storeName', 'createdAt', 'updatedAt', 'calculationMode', 'items', 'purchaseTotalYen',
            'taxRate', 'exchangeRate', 'taxExclusivePurchaseYen', 'refundBeforeFeeYen',
            'serviceFeeYen', 'payoutYen', 'payoutTwd', 'roundingAdjustmentYen'
          ])
          && data.schemaVersion == 1
          && data.id == recordId
          && data.storeName is string
          && data.storeName.size() > 0
          && data.storeName.size() <= 120
          && data.createdAt is string
          && data.updatedAt is string
          && data.calculationMode in ['items', 'purchase', 'refund']
          && data.items is list
          && data.items.size() > 0
          && data.items.size() <= 100
          && data.purchaseTotalYen is number
          && data.purchaseTotalYen >= 0
          && (data.taxRate == 0.08 || data.taxRate == 0.1)
          && data.exchangeRate is number
          && data.exchangeRate > 0
          && (data.taxExclusivePurchaseYen == null
            || data.taxExclusivePurchaseYen is number && data.taxExclusivePurchaseYen >= 0)
          && data.refundBeforeFeeYen is number
          && data.refundBeforeFeeYen >= 0
          && data.serviceFeeYen is number
          && data.serviceFeeYen >= 0
          && data.payoutYen is number
          && data.payoutYen >= 0
          && data.payoutTwd is number
          && data.payoutTwd >= 0
          && data.roundingAdjustmentYen is number;
      }

      allow read, delete: if ownsRecord();
      allow create, update: if ownsRecord() && validRecord();
    }
  }
}